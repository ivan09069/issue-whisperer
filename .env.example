# Issue Whisperer Configuration
# Copy to .env and fill in your values

# Required - GitHub PAT with repo scope
GITHUB_TOKEN=your_github_token_here

# Required - AI Provider (Groq recommended - free tier)
GROQ_API_KEY=your_groq_key_here
# OR use XAI (paid)
# XAI_API_KEY=your_xai_key_here

# Optional - AI Model (defaults shown)
AI_MODEL=llama-3.3-70b-versatile

# Optional - Webhook Security
GITHUB_WEBHOOK_SECRET=your_webhook_secret

# Optional - Redis (Railway provides this automatically)
REDIS_URL=redis://localhost:6379

# Optional - Stripe for Pro tier gating
STRIPE_SECRET_KEY=your_stripe_key_here

# Optional - Telegram alerts
TELEGRAM_TOKEN=your_telegram_bot_token
CHANNEL_ID=@your_channel

# Optional - Default repo for polling
DEFAULT_OWNER=ivan09069
DEFAULT_REPO=issue-whisperer

# Server
PORT=3000
